{
  "Local function": {
    "prefix": "fn",
    "body": ["local function ${1:name}(${2:args})", "\t$0", "end"],
    "description": "Define a local Lua function"
  },
  "Require module": {
    "prefix": "req",
    "body": "local ${1:module} = require('${2:module}')$0",
    "description": "Load a Lua module"
  }
}
